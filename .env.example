# Live Earth Engine is off by default so a public demo cannot leak a key or burn quota.
ENABLE_LIVE_GEE=false
# Local use: run `earthengine authenticate`, then set GEE_PROJECT only.
# Deployed/headless use: point this at a service-account key instead.
GEE_SERVICE_ACCOUNT_JSON=
GEE_PROJECT=

DATABASE_PATH=data/app.db
RASTER_DIR=data/rasters
MODEL_PATH=data/models/burn_lgbm.txt

# Required to POST /sites/{id}/verdict. The model never gets this.
ANALYST_TOKEN=dev-token

DEFAULT_BURN_THRESHOLD=0.91
DEFAULT_Z_THRESHOLD=3.0
MAX_AOI_KM2=2500

# Prior reports (ACLED). Your myACLED email and password; ACLED has no API keys.
# Searches send the place and dates being searched to ACLED.
ACLED_USERNAME=
ACLED_PASSWORD=
# Show clearly labelled fictional records instead of calling ACLED.
ACLED_SAMPLE=false
